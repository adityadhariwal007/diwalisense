# Public client configuration. Never add service-role or secret keys here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# SERVER ONLY. Never prefix these with VITE_. Never commit real values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CHAT_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Required on Vercel for shared rate limits; apply supabase/chat_rate_limit.sql first.
# Use an sb_secret_ key or legacy service-role key, NEVER the publishable key.
SUPABASE_SECRET_KEY=
